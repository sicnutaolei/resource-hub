# ==========================================================================
# 复制本文件为 .env 后再修改。.env 已在 .gitignore 中排除，不会被提交。
#   cp .env.example .env
#
# 本版本只保留管理员账号，注册入口已关闭；访客无需登录即可浏览公开软件。
# ==========================================================================

# ---------------------------- 必填项 ----------------------------

# Django 密钥。生成方式：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# 管理员账号
ADMIN_USERNAME=admin
# 首次部署可留空：容器会自动生成随机密码，并在日志里只打印一次。
# 已有管理员时，重建容器不会重置密码、也不会再次打印。
# 如需重置：docker compose exec web python manage.py ensure_admin --update-password
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# 允许访问的域名 / IP，逗号分隔。用域名访问时必须填，否则会 400
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.195.107,192.168.2.165

# ---------------------------- 建议配置 ----------------------------

# 生产环境务必保持 False
DEBUG=False

# 站点信息（后台「站点设置」可在线修改名称和首页 slogan）
SITE_NAME=资源小站
SITE_SUBTITLE=只分享干净、无捆绑的资源
# 首页 slogan 的初始默认值；仅首次初始化时写入数据库
SITE_SLOGAN=只分享干净、无捆绑的资源

# 首页默认每页条数，支持 20 / 24 / 30
PAGE_SIZE=24

# ---------------------------- 按需配置 ----------------------------

# 跨域 POST 才需要填；同域访问不用填。
CSRF_TRUSTED_ORIGINS=

# 前面有 nginx / 网关做 https 终止时打开。
USE_X_FORWARDED_PROTO=True

# 安全 Cookie 要求 HTTPS。纯内网 HTTP 直连调试时可临时设为 False。
SECURE_COOKIES=False

# True：由 Django 提供 /media/ 访问（省事）
# False：交给前置 nginx 直接托管 /media/（更快）
SERVE_MEDIA=True

# 容器内端口与 gunicorn 进程数
PORT=8082
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# 外链检测超时（秒）与单个上传文件大小上限（MB）
EXTERNAL_LINK_CHECK_TIMEOUT=8
MAX_UPLOAD_SIZE_MB=2048

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------- 一般不用改 ----------------------------

# SQLite 文件位置与读锁等待时间
# DB_PATH=/app/data/db.sqlite3
# SQLITE_TIMEOUT=20

# 媒体文件目录
# MEDIA_ROOT=/app/media

# 站点设置 / 筛选标签缓存目录（多 worker 共享）
# CACHE_DIR=/app/data/cache

# 容器时区
TZ=Asia/Shanghai

# 说明：
# - 数据库迁移前会自动备份到 data/backups/，默认保留最近 20 份。
# - 数据库表 auth_group / auth_permission 仍保留，但后台不再提供权限/组管理入口。
# - 封面缩略图自动生成在 media/covers/.../thumbs/，首页只加载 640x400 缩略图。