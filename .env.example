# ==========================================================================
# 复制本文件为 .env 后再修改。.env 已在 .gitignore 中排除，不会被提交。
#   cp .env.example .env
# ==========================================================================

# ---------------------------- 必填项 ----------------------------

# Django 密钥。生成方式：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string

# 管理员账号（首次启动自动创建，不会覆盖已有账号的密码）
ADMIN_USERNAME=admin
# ⚠ 部署后请立刻改成强密码，然后执行：
#   docker compose exec web python manage.py ensure_admin --update-password
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# 允许访问的域名 / IP，逗号分隔。用域名访问时必须填，否则会 400
# 线上正式入口（nginx HTTPS 反代）：mefcl.taolei.dynv6.net
# 内网直连调试用的宿主机 IP 也放进来，换网络后记得同步更新
ALLOWED_HOSTS=localhost,127.0.0.1,mefcl.taolei.dynv6.net,192.168.2.165

# ---------------------------- 建议配置 ----------------------------

# 生产环境务必保持 False
DEBUG=False

# 站点信息
SITE_NAME=资源小站
SITE_SUBTITLE=只分享干净、无捆绑的资源
SITE_FOOTER=本站资源多为第三方网盘外链，可能失效，请以实际为准。

# 列表页每页显示的资源数
PAGE_SIZE=12

# ---------------------------- 按需配置 ----------------------------

# 跨域 POST 才需要填；同域访问（域名已在 ALLOWED_HOSTS 里）不用填。
# 线上是 nginx 终止 HTTPS 后转发到 8082，属于同源，保持空即可。
CSRF_TRUSTED_ORIGINS=

# 前面有 nginx / 网关做 https 终止时打开。
# 线上由 mefcl.taolei.dynv6.net 的 443 入口反代过来，保持 True。
USE_X_FORWARDED_PROTO=True

# 安全 Cookie 要求 HTTPS。开启后 http://<内网IP>:8082 直连将无法登录，
# 因为浏览器不会在 http 下回传 Secure Cookie。保持 False 可同时用内网 IP 调试。
SECURE_COOKIES=False

# True：由 Django 提供 /media/ 访问（省事）
# False：交给前置 nginx 直接托管 /media/（更快）
SERVE_MEDIA=True

# 容器内端口与 gunicorn 进程数
PORT=8082
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# 外链检测超时（秒）与单个上传文件大小上限（MB）
EXTERNAL_LINK_CHECK_TIMEOUT=8
# 单文件硬上限，超过会被模型校验直接拒绝。大文件建议走网盘外链
MAX_UPLOAD_SIZE_MB=2048

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------- 一般不用改 ----------------------------

# SQLite 文件位置与读锁等待时间
# DB_PATH=/app/data/db.sqlite3
# SQLITE_TIMEOUT=20

# 媒体文件目录
# MEDIA_ROOT=/app/media

# 容器时区
TZ=Asia/Shanghai
